{
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_CONNECTION_STRING}",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "DatabaseProvider": "${DATABASE_PROVIDER:PostgreSQL}",
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER:https://api.bankplatform.com}",
    "Audience": "${JWT_AUDIENCE:https://app.bankplatform.com}",
    "ExpirationMinutes": "${JWT_EXPIRATION_MINUTES:60}",
    "RefreshTokenExpirationDays": "${JWT_REFRESH_EXPIRATION_DAYS:7}",
    "RequireHttpsMetadata": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bankplatform-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "CORS": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://app.bankplatform.com",
      "https://admin.bankplatform.com"
    ]
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "Global": {
      "PermitLimit": 1000,
      "WindowSizeMinutes": 1
    },
    "Authentication": {
      "PermitLimit": 5,
      "WindowSizeMinutes": 1
    },
    "Transaction": {
      "TokenLimit": 100,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodMinutes": 1
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "UI": {
      "Enabled": true,
      "Path": "/health-ui"
    }
  },
  "Integration": {
    "GHIPSS": {
      "BaseUrl": "${GHIPSS_BASE_URL}",
      "ApiKey": "${GHIPSS_API_KEY}",
      "SecretKey": "${GHIPSS_SECRET_KEY}",
      "BankCode": "${BANK_CODE}",
      "Timeout": 30,
      "RetryCount": 3,
      "Environment": "${GHIPSS_ENVIRONMENT:sandbox}"
    },
    "GhanaPay": {
      "BaseUrl": "${GHANAPAY_BASE_URL}",
      "ApiKey": "${GHANAPAY_API_KEY}",
      "SecretKey": "${GHANAPAY_SECRET_KEY}",
      "MerchantId": "${GHANAPAY_MERCHANT_ID}",
      "Timeout": 30,
      "RetryCount": 3,
      "Environment": "${GHANAPAY_ENVIRONMENT:sandbox}"
    },
    "NIA": {
      "BaseUrl": "${NIA_BASE_URL}",
      "ApiKey": "${NIA_API_KEY}",
      "SecretKey": "${NIA_SECRET_KEY}",
      "Timeout": 60,
      "RetryCount": 2,
      "Environment": "${NIA_ENVIRONMENT:sandbox}"
    },
    "Nalo": {
      "BaseUrl": "${NALO_BASE_URL}",
      "ApiKey": "${NALO_API_KEY}",
      "SmsFrom": "${NALO_SMS_FROM:BankPlatform}",
      "EmailFrom": "${NALO_EMAIL_FROM:noreply@bankplatform.com}",
      "Timeout": 30,
      "RetryCount": 3
    }
  },
  "Security": {
    "EncryptionKey": "${ENCRYPTION_KEY}",
    "HashingSalt": "${HASHING_SALT}",
    "RequireHttps": true,
    "PasswordPolicy": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredLength": 12,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "DefaultLockoutTimeSpanMinutes": 15,
      "MaxFailedAccessAttempts": 3,
      "AllowedForNewUsers": true
    },
    "Session": {
      "TimeoutMinutes": 30,
      "SlidingExpiration": true,
      "RequireHttps": true
    }
  },
  "BusinessRules": {
    "Transaction": {
      "MaxDailyLimit": 500000,
      "MaxMonthlyLimit": 5000000,
      "MaxSingleTransactionLimit": 100000,
      "MinTransactionAmount": 1,
      "Currency": "GHS"
    },
    "Account": {
      "MinimumOpeningBalance": 50,
      "DefaultDailyLimit": 50000,
      "DefaultMonthlyLimit": 500000
    },
    "Loan": {
      "MaxLoanAmount": 1000000,
      "MinLoanAmount": 100,
      "MaxTenureMonths": 120,
      "MinTenureMonths": 1,
      "DefaultInterestRate": 24.0
    }
  },
  "Compliance": {
    "BOG": {
      "ReportingEnabled": true,
      "ReportingSchedule": "0 2 * * *",
      "AuditRetentionDays": 2555,
      "RequireDocumentRetention": true
    },
    "AML": {
      "KYCRequired": true,
      "PEPScreeningEnabled": true,
      "SanctionsScreeningEnabled": true,
      "TransactionMonitoringEnabled": true
    },
    "DataProtection": {
      "EncryptionAtRest": true,
      "EncryptionInTransit": true,
      "DataRetentionDays": 2555,
      "AnonymizationEnabled": true
    }
  },
  "Monitoring": {
    "OpenTelemetry": {
      "ServiceName": "BankPlatform.API",
      "ServiceVersion": "1.0.0",
      "Jaeger": {
        "AgentHost": "${JAEGER_AGENT_HOST:localhost}",
        "AgentPort": "${JAEGER_AGENT_PORT:6831}"
      }
    },
    "Metrics": {
      "Enabled": true,
      "CollectionInterval": 30
    }
  },
  "Cache": {
    "DefaultExpirationMinutes": 15,
    "SlidingExpiration": true,
    "Profiles": {
      "ShortTerm": {
        "ExpirationMinutes": 5
      },
      "MediumTerm": {
        "ExpirationMinutes": 30
      },
      "LongTerm": {
        "ExpirationMinutes": 240
      }
    }
  }
}