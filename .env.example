# BoG-Compliant Digital Banking Platform Environment Variables
# Copy this file to .env and configure your specific values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_NAME=bankplatform
DATABASE_USER=bankplatform
DATABASE_PASSWORD=SecureP@ssw0rd123
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=bankplatform;Username=bankplatform;Password=SecureP@ssw0rd123;Include Error Detail=true
DATABASE_PROVIDER=PostgreSQL

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=SecureRedisP@ss123
REDIS_CONNECTION_STRING=localhost:6379,password=SecureRedisP@ss123

# =============================================================================
# JWT & SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET_KEY=YourVeryLongSecretKeyThatIsAtLeast32CharactersLongForMaximumSecurity123456789
JWT_ISSUER=https://api.bankplatform.com
JWT_AUDIENCE=https://app.bankplatform.com
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Encryption & Hashing
ENCRYPTION_KEY=YourEncryptionKeyThatIs32Chars12
HASHING_SALT=YourHashingSaltThatIs16Chars

# =============================================================================
# BANK CONFIGURATION
# =============================================================================
BANK_CODE=BP001
BANK_NAME=Bank Platform
BANK_SHORT_NAME=BankPlatform

# =============================================================================
# GHIPSS INTEGRATION (Ghana Interbank Payment & Settlement Systems)
# =============================================================================
GHIPSS_BASE_URL=https://sandbox.ghipss.net/api/v1
GHIPSS_API_KEY=your-ghipss-api-key
GHIPSS_SECRET_KEY=your-ghipss-secret-key
GHIPSS_ENVIRONMENT=sandbox

# =============================================================================
# GHANAPAY INTEGRATION (Mobile Money)
# =============================================================================
GHANAPAY_BASE_URL=https://sandbox.ghanapay.com/api/v1
GHANAPAY_API_KEY=your-ghanapay-api-key
GHANAPAY_SECRET_KEY=your-ghanapay-secret-key
GHANAPAY_MERCHANT_ID=your-merchant-id
GHANAPAY_ENVIRONMENT=sandbox

# =============================================================================
# NIA INTEGRATION (National Identification Authority - e-KYC)
# =============================================================================
NIA_BASE_URL=https://sandbox.nia.gov.gh/api/v1
NIA_API_KEY=your-nia-api-key
NIA_SECRET_KEY=your-nia-secret-key
NIA_ENVIRONMENT=sandbox

# =============================================================================
# NALO INTEGRATION (SMS & Email Services)
# =============================================================================
NALO_BASE_URL=https://api.nalo.com/v1
NALO_API_KEY=your-nalo-api-key
NALO_SMS_FROM=BankPlatform
NALO_EMAIL_FROM=noreply@bankplatform.com

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
RUN_MIGRATIONS_ON_STARTUP=true

# =============================================================================
# PRODUCTION SETTINGS (Override for production)
# =============================================================================
# ASPNETCORE_ENVIRONMENT=Production
# DATABASE_CONNECTION_STRING=Host=your-prod-db-host;Port=5432;Database=bankplatform;Username=prod_user;Password=your-secure-prod-password;SSL Mode=Require
# REDIS_CONNECTION_STRING=your-prod-redis-host:6379,password=your-secure-redis-password,ssl=true
# JWT_SECRET_KEY=your-ultra-secure-production-jwt-secret-key-at-least-256-bits
# ENCRYPTION_KEY=your-production-encryption-key-32-chars
# HASHING_SALT=your-prod-salt-16c

# =============================================================================
# INTEGRATION PRODUCTION ENDPOINTS (Update for production)
# =============================================================================
# GHIPSS_BASE_URL=https://api.ghipss.net/v1
# GHIPSS_ENVIRONMENT=production
# GHANAPAY_BASE_URL=https://api.ghanapay.com/v1
# GHANAPAY_ENVIRONMENT=production
# NIA_BASE_URL=https://api.nia.gov.gh/v1
# NIA_ENVIRONMENT=production

# =============================================================================
# SSL/TLS CERTIFICATES (Production)
# =============================================================================
# SSL_CERT_PATH=/app/ssl/cert.pem
# SSL_KEY_PATH=/app/ssl/key.pem
# SSL_CA_PATH=/app/ssl/ca.pem

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
# BACKUP_CONNECTION_STRING=your-backup-storage-connection-string
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=90

# =============================================================================
# COMPLIANCE & AUDIT
# =============================================================================
# AUDIT_LOG_RETENTION_DAYS=2555  # 7 years as per BoG requirements
# COMPLIANCE_REPORTING_EMAIL=compliance@bankplatform.com
# FRAUD_MONITORING_WEBHOOK=https://your-fraud-monitoring-webhook

# =============================================================================
# RATE LIMITING
# =============================================================================
# RATE_LIMIT_GLOBAL=1000
# RATE_LIMIT_AUTH=5
# RATE_LIMIT_TRANSACTION=100

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# ENABLE_BIOMETRIC_AUTH=true
# ENABLE_OFFLINE_TRANSACTIONS=false
# ENABLE_CARD_PAYMENTS=true
# ENABLE_INTERNATIONAL_TRANSFERS=false

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
# SMS_PROVIDER=nalo
# EMAIL_PROVIDER=nalo
# PUSH_NOTIFICATION_PROVIDER=firebase
# FIREBASE_SERVER_KEY=your-firebase-server-key

# =============================================================================
# BUSINESS RULES
# =============================================================================
# MAX_DAILY_TRANSACTION_LIMIT=500000
# MAX_MONTHLY_TRANSACTION_LIMIT=5000000
# MAX_SINGLE_TRANSACTION_LIMIT=100000
# MIN_ACCOUNT_OPENING_BALANCE=50
# DEFAULT_LOAN_INTEREST_RATE=24.0

# =============================================================================
# DEVELOPMENT SETTINGS (Development only)
# =============================================================================
# ENABLE_SWAGGER_UI=true
# ENABLE_DETAILED_ERRORS=true
# ENABLE_SENSITIVE_DATA_LOGGING=false
# SEED_DEMO_DATA=true